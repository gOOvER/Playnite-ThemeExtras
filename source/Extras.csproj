<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>{4FDF1E89-5BC3-4C72-8FDA-0D580E7A5D5F}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Extras</RootNamespace>
    <AssemblyName>Extras</AssemblyName>
    <TargetFramework>net462</TargetFramework>
    <UseWpf>true</UseWpf>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PresentationFramework.Aero" />
    <Reference Include="PresentationFramework.Aero2" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="extension.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\extern\PlayniteCommon\PlayniteCommon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.18.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="PackOnRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and Exists('$(LOCALAPPDATA)\Playnite\Toolbox.exe')">
    <Exec Command="&quot;$(LOCALAPPDATA)\Playnite\Toolbox.exe&quot; pack &quot;$(TargetDir.TrimEnd('\'))&quot; &quot;$(ProjectDir)bin&quot;" />
  </Target>
</Project>